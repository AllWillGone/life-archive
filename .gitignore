# Ignore private or local material by default.

# Operating system files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Local exports and temporary files
*.tmp
*.bak
*.log
exports/
local/
private/

# Defense in depth for a public-template checkout. These patterns affect only
# untracked files; they do not protect starter summaries or indexes already
# tracked by Git. Use a separate private repository for real memory.
fact/events/**
!fact/events/.gitkeep
feeling/by_event/**
!feeling/by_event/.gitkeep
people/**
!people/.gitkeep
session/**
!session/.gitkeep
inbox/**
!inbox/.gitkeep
!inbox/unresolved.md
archive/**
!archive/old/
!archive/old/.gitkeep
support/by_event/**
!support/by_event/.gitkeep

# Keep public-template entry points and synthetic examples trackable.
!fact/index.md
!feeling/index.md
!examples/**/*.md
